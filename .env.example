# ─── Base de données ─────────────────────────────────────────────
# Utilisée par l'API (et par drizzle-kit pour les migrations).
DATABASE_URL=postgres://kenpai:kenpai@localhost:5432/kenpai

# ─── API (Fastify) ───────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Origine publique du site (utilisée pour CORS et, plus tard, les cookies).
WEB_ORIGIN=http://localhost:3000

# ─── Web (Next.js) ───────────────────────────────────────────────
# URL interne à laquelle Next.js relaie les appels /api/* vers l'API.
API_INTERNAL_URL=http://localhost:4000

# Cookie de session réservé au HTTPS (true par défaut en production).
# COOKIE_SECURE=false

# ─── Tests ───────────────────────────────────────────────────────
# Base dédiée aux tests d'intégration (créée automatiquement).
# TEST_DATABASE_URL=postgres://kenpai:kenpai@localhost:5432/kenpai_test

# Variables ajoutées plus tard (ne pas remplir maintenant) :
# DISCORD_CLIENT_ID=      (connexion Discord)
# DISCORD_CLIENT_SECRET=  (connexion Discord)
