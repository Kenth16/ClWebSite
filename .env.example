# ─── Base de données ─────────────────────────────────────────────
# Utilisée par l'API (et par drizzle-kit pour les migrations).
DATABASE_URL=postgres://kenpai:kenpai@localhost:5432/kenpai

# ─── API (Fastify) ───────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
# Origine publique du site (utilisée pour CORS et, plus tard, les cookies).
WEB_ORIGIN=http://localhost:3000

# ─── Web (Next.js) ───────────────────────────────────────────────
# URL interne à laquelle Next.js relaie les appels /api/* vers l'API.
API_INTERNAL_URL=http://localhost:4000

# Variables ajoutées aux étapes suivantes (ne pas remplir maintenant) :
# AUTH_SECRET=            (étape 2 — sessions)
# DISCORD_CLIENT_ID=      (étape 2 — connexion Discord)
# DISCORD_CLIENT_SECRET=  (étape 2 — connexion Discord)
